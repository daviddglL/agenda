root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_filename = disabled
# Los @Composable siguen la convencion de Compose (PascalCase), no la de ktlint
ktlint_function_naming_ignore_when_annotated_with = Composable

# Codigo generado (KSP de Room, recursos de Compose Multiplatform): no lo escribimos
# nosotros y no debe fallar el lint del proyecto.
[**/build/**.kt]
ktlint = disabled
